          "section_name": "Section A (MCQs - 1 Mark Each)",
          "questions": [
            {
              "question_number": 1,
              "question_text": "Which identity represents the difference of squares?",
              "options": [
                "A) (a+b)^2",
                "B) a^2 - b^2 = (a-b)(a+b)",
                "C) (a-b)^2",
                "D) a^3 + b^3"
              ],
              "correct_answer": "B) a^2 - b^2 = (a-b)(a+b)",
              "marks": 1
            },
            {
              "question_number": 2,
              "question_text": "If a + b + c = 0, then a^3 + b^3 + c^3 equals:",
              "options": [
                "A) 0",
                "B) abc",
                "C) 3abc",
                "D) a+b+c"
              ],
              "correct_answer": "C) 3abc",
              "marks": 1
            }
          ]
        },
        {
          "section_name": "Section B (Short Answer - 2 Marks Each)",
          "questions": [
            {
              "question_number": 3,
              "question_text": "Evaluate (101) * (99) using algebraic identity.",
              "marking_scheme_answer": "Difference of squares: (100+1)(100-1) = 100^2 - 1^2 = 10000 - 1 = 9999.",
              "marks": 2
            },
            {
              "question_number": 4,
              "question_text": "Factorise: 1x^2 + 7x + 6.",
              "marking_scheme_answer": "Middle term split: (1x + 1)(x + 6).",
              "marks": 2
            }
          ]
        },
        {
          "section_name": "Section C (Short Answer - 3 Marks)",
          "questions": [
            {
              "question_number": 5,
              "question_text": "If x + 1/x = 3, find x^2 + 1/x^2.",
              "marking_scheme_answer": "Square both sides: (x + 1/x)^2 = 3^2 => x^2 + 2 + 1/x^2 = 9 => x^2 + 1/x^2 = 7.",
              "marks": 3
            }
          ]
        },
        {
          "section_name": "Section D (Long Answer - 5 Marks)",
          "questions": [
            {
              "question_number": 6,
              "question_text": "Factorise completely using Factor Theorem: x^3 - 6x^2 + 11x - 6.",
              "marking_scheme_answer": "Test x = 1: p(1) = 0 => (x - 1) is a factor. Polynomial division yields (x - 1)(x - 2)(x - 3) scaled appropriately.",
              "marks": 5
            }
          ]
        },
        {
          "section_name": "Section E (Case Study - 4 Marks)",
          "questions": [
            {
              "question_number": 7,
              "question_text": "A cubical room of edge 'a' is extended by 'b' meters in all 3 dimensions.\n(i) State formula for total expanded volume. (2 Marks)\n(ii) List the 4 distinct geometric shape volumes comprising (a+b)^3. (2 Marks)",
              "marking_scheme_answer": "(i) Volume = (a+b)^3 = a^3 + b^3 + 3a^2 b + 3ab^2.\n(ii) 1 cube of a^3, 1 cube of b^3, 3 prisms of a^2 b, 3 prisms of ab^2.",
              "marks": 4
            }
          ]
        }
