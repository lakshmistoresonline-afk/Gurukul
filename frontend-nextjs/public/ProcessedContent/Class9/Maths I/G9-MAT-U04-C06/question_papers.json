          "questions": [
            {
              "question_number": 1,
              "question_text": "Heron's formula for area of a triangle with sides a, b, c is:",
              "options": [
                "A) s(s-a)(s-b)(s-c)",
                "B) sqrt(s(s-a)(s-b)(s-c))",
                "C) 1/2 * a * b",
                "D) a+b+c"
              ],
              "correct_answer": "B) sqrt(s(s-a)(s-b)(s-c))",
              "marks": 1
            },
            {
              "question_number": 2,
              "question_text": "Area of a sector with radius r and central angle theta (in degrees) is:",
              "options": [
                "A) (theta/360)*2*pi*r",
                "B) (theta/360)*pi*r^2",
                "C) pi*r^2",
                "D) 2*pi*r"
              ],
              "correct_answer": "B) (theta/360)*pi*r^2",
              "marks": 1
            }
          ]
        },
        {
          "section_name": "Section B (Short Answer - 2 Marks Each)",
          "questions": [
            {
              "question_number": 3,
              "question_text": "Find area of equilateral triangle with side 4 cm.",
              "marking_scheme_answer": "Area = (sqrt(3)/4) * a^2 = (sqrt(3)/4) * (4)^2 = 4*sqrt(3) sq cm.",
              "marks": 2
            },
            {
              "question_number": 4,
              "question_text": "Find area swept by a minute hand of length 7 cm in 5 minutes.",
              "marking_scheme_answer": "theta = 30°. Area = (30/360)*(22/7)*(7)^2 = (1/12)*(22/7)*(49*1) = 51.333333333333336 sq cm.",
              "marks": 2
            }
          ]
        },
        {
          "section_name": "Section C (Short Answer - 3 Marks)",
          "questions": [
            {
              "question_number": 5,
              "question_text": "Calculate area of triangle with sides 13 m, 14 m, 15 m scaled by factor 1.",
              "marking_scheme_answer": "s = 21*1. Area = sqrt((21*1) * (8*1) * (7*1) * (6*1)) = 84*1 sq m.",
              "marks": 3
            }
          ]
        },
        {
          "section_name": "Section D (Long Answer - 5 Marks)",
          "questions": [
            {
              "question_number": 6,
              "question_text": "A park is in shape of trapezium with parallel sides 25 m and 10 m, and non-parallel sides 14 m and 13 m. Find its total area.",
              "marking_scheme_answer": "1. Split trapezium into parallelogram (10m x 13m) and triangle (sides 13m, 14m, 15m).\n2. Triangle area = 84 sq m.\n3. Triangle height h = (2 * 84) / 15 = 11.2 m.\n4. Trapezium Area = 1/2 * (25 + 10) * 11.2 = 196 sq m.",
              "marks": 5
            }
          ]
        },
        {
          "section_name": "Section E (Case Study - 4 Marks)",
          "questions": [
            {
              "question_number": 7,
              "question_text": "A running track has outer radius R = 21 m and inner radius r = 14 m.\n(i) Calculate track surface area. (2 Marks)\n(ii) Calculate outer fence perimeter. (2 Marks)",
              "marking_scheme_answer": "(i) Area = pi*(R^2 - r^2) = (22/7)*(441 - 196) = 770 sq m.\n(ii) Perimeter = 2*pi*R = 2*(22/7)*(21) = 132 m.",
              "marks": 4
            }
          ]
        }
      ]
