          "questions": [
            {
              "question_number": 1,
              "question_text": "What is common difference 'd' of AP: -5, -1, 3, 7...?",
              "options": [
                "A) -4",
                "B) 4",
                "C) 3",
                "D) -5"
              ],
              "correct_answer": "B) 4",
              "marks": 1
            },
            {
              "question_number": 2,
              "question_text": "The n-th triangular number formula T_n is:",
              "options": [
                "A) n^2",
                "B) n(n+1)/2",
                "C) 2n - 1",
                "D) n(n-1)"
              ],
              "correct_answer": "B) n(n+1)/2",
              "marks": 1
            }
          ]
        },
        {
          "section_name": "Section B (Short Answer - 2 Marks Each)",
          "questions": [
            {
              "question_number": 3,
              "question_text": "Which term of the AP 3, 8, 13, 18... is 78?",
              "marking_scheme_answer": "a = 3, d = 5. t_n = a + (n-1)d => 78 = 3 + 5(n-1) => 75 = 5(n-1) => n-1 = 15 => n = 16th term.",
              "marks": 2
            },
            {
              "question_number": 4,
              "question_text": "Find sum of first 10 natural numbers.",
              "marking_scheme_answer": "S_n = n(n+1)/2 => S_10 = (10 * 11) / 2 = 55.",
              "marks": 2
            }
          ]
        },
        {
          "section_name": "Section C (Short Answer - 3 Marks)",
          "questions": [
            {
              "question_number": 5,
              "question_text": "The 3rd term of an AP is 7 and 7th term is 19. Find first term 'a' and common difference 'd'.",
              "marking_scheme_answer": "1. a + 2d = 7\n2. a + 6d = 19\nSubtract: 4d = 12 => d = 3. Substitute: a + 6 = 7 => a = 1.",
              "marks": 3
            }
          ]
        },
        {
          "section_name": "Section D (Long Answer - 5 Marks)",
          "questions": [
            {
              "question_number": 6,
              "question_text": "For AP with a = 2 and d = 5: (i) Find 10th term t_10. (ii) Find sum of first 20 terms S_20.",
              "marking_scheme_answer": "(i) t_10 = 2 + 9(5) = 2 + 45 = 47.\n(ii) S_20 = (20/2) * [2(2) + 19(5)] = 10 * [4 + 95] = 10 * 99 = 990.",
              "marks": 5
            }
          ]
        },
        {
          "section_name": "Section E (Case Study - 4 Marks)",
          "questions": [
            {
              "question_number": 7,
              "question_text": "A savings scheme deposits Rs. 1000 in month 1 and increases by Rs. 200 each month.\n(i) Deposit in month 12. (2 Marks)\n(ii) Total accumulated savings after 12 months. (2 Marks)",
              "marking_scheme_answer": "(i) t_12 = 1000 + 11(200) = Rs. 3200.\n(ii) S_12 = (12/2) * [1000 + 3200] = 6 * 4200 = Rs. 25200.",
              "marks": 4
            }
          ]
        }
      ]
