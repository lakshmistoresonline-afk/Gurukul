{
  "chapter_number": 7,
  "chapter_title": "Maths Chapter 7",
  "mind_map": {
    "root_topic": "Chapter 7: Fractions",
    "branches": [
      {
        "theme": "7.1 Concept of Equal Sharing & Unit Fractions",
        "sub_branches": [
          {
            "concept_or_rule": "Equal Shares & Fractional Units",
            "step_by_step_procedure": [
              "Divide 1 whole unit into n equal parts.",
              "Each part represents unit fraction 1/n.",
              "Denominator n specifies total equal parts; Numerator a specifies count of parts chosen."
            ],
            "formulas_and_identities": [
              "Fraction = a / b (b != 0)"
            ],
            "example_problem": "3 rotis shared equally among 4 children: Each gets 3/4 roti."
          },
          {
            "concept_or_rule": "Denominator Size Inversion Rule",
            "step_by_step_procedure": [
              "Compare unit fractions 1/m and 1/n.",
              "As denominator increases, individual share size DECREASES."
            ],
            "formulas_and_identities": [
              "If m > n, then 1/m < 1/n"
            ],
            "example_problem": "Compare 1/8 and 1/3: 8 > 3 => 1/8 < 1/3."
          }
        ]
      },
      {
        "theme": "7.2 Fraction Classification & Number Line Representation",
        "sub_branches": [
          {
            "concept_or_rule": "Proper, Improper, and Mixed Fractions",
            "step_by_step_procedure": [
              "Proper Fraction: Numerator < Denominator (Value < 1).",
              "Improper Fraction: Numerator >= Denominator (Value >= 1).",
              "Mixed Fraction: Whole Integer + Proper Fraction."
            ],
            "formulas_and_identities": [
              "Mixed to Improper: A b/c = (A x c + b) / c"
            ],
            "example_problem": "Convert 3 1/4 to improper: (3 x 4 + 1) / 4 = 13/4."
          },
          {
            "concept_or_rule": "Number Line Fraction Placement",
            "step_by_step_procedure": [
              "Divide unit interval between consecutive integers into n equal sub-segments.",
              "Count 'a' sub-segments from left to locate a/n."
            ],
            "formulas_and_identities": [
              "Sub-segment length = 1 / n"
            ],
            "example_problem": "Locate 3/5: Divide 0-1 into 5 equal parts, mark 3rd tick from 0."
          }
        ]
      },
      {
        "theme": "7.3 Equivalent Fractions & Fraction Walls",
        "sub_branches": [
          {
            "concept_or_rule": "Generating Equivalent Fractions",
            "step_by_step_procedure": [
              "Multiply or divide both numerator and denominator by the same non-zero integer k.",
              "Value remains unchanged."
            ],
            "formulas_and_identities": [
              "a / b = (a x k) / (b x k)"
            ],
            "example_problem": "Find equivalent fractions for 2/3: 2/3 = 4/6 = 6/9 = 8/12."
          }
        ]
      },
      {
        "theme": "7.4 Fraction Arithmetic & Brahmagupta's General Formulas",
        "sub_branches": [
          {
            "concept_or_rule": "Like Denominator Addition and Subtraction",
            "step_by_step_procedure": [
              "When denominators are identical, add or subtract numerators directly.",
              "Keep denominator unchanged."
            ],
            "formulas_and_identities": [
              "a/b + c/b = (a + c) / b"
            ],
            "example_problem": "2/7 + 5/7 = (2 + 5) / 7 = 7/7 = 1."
          },
          {
            "concept_or_rule": "Brahmagupta's General Formulas (Unlike Denominators)",
            "step_by_step_procedure": [
              "Cross-multiply numerators and denominators to find common fractional unit.",
              "Addition: a/b + c/d = (a.d + b.c) / (b.d).",
              "Subtraction: a/b - c/d = (a.d - b.c) / (b.d)."
            ],
            "formulas_and_identities": [
              "Brahmagupta Addition: a/b + c/d = (a.d + b.c) / (b.d)",
              "Brahmagupta Subtraction: a/b - c/d = (a.d - b.c) / (b.d)"
            ],
            "example_problem": "2/5 + 1/3 = (2x3 + 5x1) / (5x3) = (6 + 5) / 15 = 11/15."
          }
        ]
      }
    ]
  },
