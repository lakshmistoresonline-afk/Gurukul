    "chapters": [
      {
        "chapter_number": 1,
        "chapter_title": "Development",
        "executive_summary": "Development encompasses material aspirations (higher income, employment) as well as non-material goals like freedom, security, equal treatment, and respect. Relying solely on per capita income ignores income distribution and essential human indicators like literacy, life expectancy, and infant mortality.",
        "storyboard": [
          {
            "frame_id": 1,
            "title": "Different People, Different Goals",
            "description": "Visualizing how an industrialist's goal of building a hydro dam conflicts directly with a tribal community's goal of preserving their ancestral land.",
            "key_takeaway": "Developmental goals can be distinct and mutually conflicting."
          },
          {
            "frame_id": 2,
            "title": "Income vs. Human Indicators",
            "description": "Comparing Haryana's higher income with Kerala's superior health (IMR 7) and education (94% literacy) metrics.",
            "key_takeaway": "Money cannot buy essential public healthcare and social security."
          },
          {
            "frame_id": 3,
            "title": "Ecological Balance & Sustainability",
            "description": "Illustrating groundwater table collapse in agricultural states and global crude oil depletion.",
            "key_takeaway": "Present development must maintain inter-generational equity."
          }
        ],
        "video_embeds": [
          {
            "video_id": "vid_ch1_01",
            "title": "Understanding Human Development Index & PCI",
            "duration": "04:45",
            "video_url": "media/video_ch1_hdi.mp4",
            "transcript_summary": "Explains the difference between World Bank Per Capita Income criteria and UNDP HDI composite metrics."
          }
        ],
        "hotspot_overlays": {
          "image_url": "ch1_development.png",
          "aspect_ratio": "16:9",
          "hotspots": [
            {
              "id": "h1_1",
