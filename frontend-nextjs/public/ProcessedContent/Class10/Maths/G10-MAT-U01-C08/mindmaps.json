        "theme": "Trigonometric Ratios and Specific Angles",
        "sub_branches": [
          {
            "concept": "Primary & Reciprocal Ratios",
            "details": [
              "In right ΔABC (∠B = 90°): sin A = Opp/Hyp, cos A = Adj/Hyp, tan A = Opp/Adj.",
              "Reciprocals: cosec A = 1/sin A, sec A = 1/cos A, cot A = 1/tan A.",
              "Specific angle values (0°, 30°, 45°, 60°, 90°): sin 30° = 1/2, cos 30° = √3/2, tan 45° = 1."
            ],
            "evidence_or_examples": [
              "Evaluate 2 tan^2 45° + cos^2 30° - sin^2 60° = 2(1)^2 + 3/4 - 3/4 = 2.",
              "If sin(A-B) = 1/2 and cos(A+B) = 1/2 => A-B = 30°, A+B = 60° => A = 45°, B = 15°."
            ],
            "key_terms": [
              "Sine",
              "Cosine",
              "Tangent",
              "Cosecant",
              "Secant",
              "Cotangent"
            ]
          }
        ]
      },
      {
        "theme": "Trigonometric Identities",
        "sub_branches": [
          {
            "concept": "Pythagorean Identities",
            "details": [
              "1) sin^2 A + cos^2 A = 1",
              "2) 1 + tan^2 A = sec^2 A (0° <= A < 90°)",
              "3) 1 + cot^2 A = cosec^2 A (0° < A <= 90°)"
            ],
            "evidence_or_examples": [
              "Prove (cosec θ - cot θ)^2 = (1 - cos θ) / (1 + cos θ).",
              "Prove sin A (1 + tan A) + cos A (1 + cot A) = sec A + cosec A."
            ],
            "key_terms": [
              "Pythagorean Identity",
              "Algebraic Proofs",
              "Identity Verification"
            ]
          }
        ]
      }
    ],
