{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gurukul Learning Content",
  "type": "object",
  "required": [
    "content_id",
    "content_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_id": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": [
        "object",
        "array",
        "string",
        "null"
      ]
    },
    "media_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true
}