{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gurukul Assessment",
  "type": "object",
  "required": [
    "assessment_id",
    "assessment_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment_id": {
      "type": "string"
    },
    "assessment_type": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "question_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instructions": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "duration_seconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "total_marks": {
      "type": [
        "number",
        "null"
      ]
    },
    "rubric": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true
}