  "source_data": {
    "subject": "LANGUAGE",
    "chapter": {
      "book_title": "Poorvi: Textbook of English for Grade 7",
      "curriculum_framework": "NCERT / NCF-2023 / CBSE Class 7",
      "covered_units": [
        "Unit 1: Learning Together (The Day the River Spoke & Try Again)",
        "Unit 2: Wit and Humour (Animals, Birds, and Dr. Dolittle & A Funny Man)",
        "Unit 3: Dreams and Discoveries (My Brother's Great Invention & Paper Boats)",
        "Unit 4: Travel and Adventure (The Tunnel by Ruskin Bond & Travel)",
        "Unit 5: Bravehearts (A Homage to Our Brave Soldiers & My Dear Soldiers)"
      ]
    },
    "content": {
      "grammar": [
        {
          "id": "GRAM_01",
          "topic": "Types of Compound Words",
          "rule": "Compound words are formed by combining two or more distinct words to create a new word with a distinct meaning. They are classified into three types: Closed, Open, and Hyphenated.",
          "sub_categories": {
            "Closed Compound Words": "Joined without spaces or hyphens (e.g., windowsill, flowerpots, teatime).",
            "Open Compound Words": "Written as separate words with spaces functioning together as a single unit (e.g., bird language, plough horse, harvest mice).",
            "Hyphenated Compound Words": "Joined by hyphens (e.g., Cat's-food-Man, check-in, well-bred)."
          },
          "source_context": "Unit 2: Wit and Humour (Animals, Birds, and Dr. Dolittle) - Grammar Focus"
        },
        {
          "id": "GRAM_02",
          "topic": "Present Perfect Tense",
          "rule": "The Present Perfect Tense is formed using 'has/have' + Past Participle (third form of verb). It expresses actions that occurred at an indefinite time in the past or actions that began in the past and have relevance or completion in the present.",
          "examples": [
            "Dr. Dolittle has learned the language of birds.",
            "The children have floated paper boats down the stream.",
            "Soumya has visited the National War Memorial in New Delhi."
          ],
          "source_context": "Unit 2: Wit and Humour & Unit 5: Bravehearts - Grammar Exercises"
        },
        {
          "id": "GRAM_03",
          "topic": "Expressing Habitual Past with 'Would'",
          "rule": "The modal auxiliary verb 'would' followed by the base form of the verb is used to describe past routine habits, repeated actions, or characteristic behavior that happened regularly in the past.",
          "examples": [
            "Sunder Singh would inspect the tracks before every train arrived.",
            "Jahnavi would sit by the riverbank every evening after finishing her chores."
          ],
          "contrast_note": "Use 'used to be' for past states/conditions, and 'would' for repeated past actions.",
          "source_context": "Unit 4: Travel and Adventure (The Tunnel by Ruskin Bond) - Language Structure"
        },
        {
          "id": "GRAM_04",
          "topic": "Phrasal Verbs",
          "rule": "A phrasal verb consists of a main verb combined with a preposition or an adverb (or both) to form a idiomatic phrase with a meaning distinct from the original verb.",
          "examples": [
            "give up (to stop trying / abandon)",
            "run away (to escape)",
            "look after (to care for someone)",
            "burst out (to emerge suddenly)",
            "go down with (to sink along with a ship)"
          ],
          "source_context": "Unit 2: Wit and Humour & Unit 4: Travel and Adventure - Vocabulary & Phrasal Verbs"
        },
        {
          "id": "GRAM_05",
          "topic": "Direct and Indirect Speech Basics",
          "rule": "Direct speech quotes the exact words spoken enclosed in quotation marks. Indirect (reported) speech conveys what was said without exact quotes, adjusting pronouns, verb tenses, and time indicators accordingly.",
          "examples": [
            "Direct: The River said, 'You can go to school.'",
            "Indirect: The River told Jahnavi that she could go to school."
          ],
          "source_context": "Unit 1: Learning Together (The Day the River Spoke) - Dialogue Analysis"
        }
      ],
      "vocabulary": [
        {
          "term": "Ettan",
          "meaning": "An affectionate and respectful Malayalam term used for an elder brother.",
          "part_of_speech": "Noun (Regional/Cultural)",
          "source_context": "Unit 1: The Day the River Spoke (Jahnavi referring to her elder brother Gopi)"
        },
        {
          "term": "Catamaran",
          "meaning": "A multi-hulled wooden boat or raft traditionally used by coastal fishermen in South India.",
          "part_of_speech": "Noun",
          "source_context": "Unit 1: The Day the River Spoke (Fishermen on the sea)"
        },
        {
          "term": "Pañchakośhas",
          "meaning": "The five holistic layers of human experience in Indian philosophy (Annamaya, Prāṇamaya, Manomaya, Vijñānamaya, Ānandamaya).",
          "part_of_speech": "Noun (Philosophical/Pedagogical)",
          "source_context": "Unit 1: NCF-2023 Framework Box"
        },
        {
          "term": "Puddleby-on-the-Marsh",
          "meaning": "The fictional English town where Doctor John Dolittle resides and conducts his medical practice.",
          "part_of_speech": "Proper Noun",
          "source_context": "Unit 2: Animals, Birds, and Dr. Dolittle"
        },
        {
          "term": "Scholar",
          "meaning": "A learned person who has acquired advanced knowledge in a specific field of study.",
          "part_of_speech": "Noun",
          "source_context": "Unit 2: Animals, Birds, and Dr. Dolittle (Dr. Dolittle as an animal scholar)"
        },
        {
          "term": "Staggered",
          "meaning": "Walked or moved unsteadily, as if about to fall.",
          "part_of_speech": "Verb (Past Tense)",
          "source_context": "Unit 2: A Funny Man (The funny man walking in an inverted posture)"
        },
        {
          "term": "Currant",
          "meaning": "A small, dried, seedless grape widely used in baking cakes and buns.",
          "part_of_speech": "Noun",
          "source_context": "Unit 2: A Funny Man (Eating a currant bun)"
        },
        {
          "term": "Shiuli (Parijat)",
          "meaning": "A delicate, fragrant white flower with an orange stem that blooms at night and drops at dawn.",
          "part_of_speech": "Noun",
          "source_context": "Unit 3: Paper Boats by Rabindranath Tagore"
        },
        {
          "term": "Lading",
          "meaning": "The cargo, freight, or load carried by a vessel, ship, or boat.",
          "part_of_speech": "Noun (Archaic/Poetic)",
          "source_context": "Unit 3: Paper Boats ('baskets full of dreams is their lading')"
        },
        {
          "term": "Cutting",
          "meaning": "An open passage excavated through a hill or high ground to allow a railway track or road to pass.",
          "part_of_speech": "Noun (Engineering/Geography)",
          "source_context": "Unit 4: The Tunnel by Ruskin Bond"
        },
        {
          "term": "Flinch",
          "meaning": "To make a sudden quick movement back or away from something owing to fear, surprise, or pain.",
          "part_of_speech": "Verb",
          "source_context": "Unit 4: The Tunnel"
        },
        {
          "term": "Instinctively",
          "meaning": "Prompted by natural instinct or impulse without conscious reasoning or deliberation.",
          "part_of_speech": "Adverb",
          "source_context": "Unit 4: The Tunnel"
        },
        {
          "term": "Plume",
          "meaning": "A long, feather-like rising column of smoke, steam, or dust.",
          "part_of_speech": "Noun",
          "source_context": "Unit 4: The Tunnel (Steam locomotive smoke plume)"
        },
        {
          "term": "Obelisk",
          "meaning": "A tall, four-sided stone pillar that tapers towards a pyramidal top.",
          "part_of_speech": "Noun",
          "source_context": "Unit 5: A Homage to Our Brave Soldiers (National War Memorial central structure)"
        },
        {
          "term": "Posthumous",
          "meaning": "Awarded, published, or occurring after an individual's death.",
          "part_of_speech": "Adjective",
          "source_context": "Unit 5: A Homage to Our Brave Soldiers (Gallantry awards conferred posthumously)"
        },
        {
          "term": "Homage",
          "meaning": "Special honor or respect shown publicly toward someone.",
          "part_of_speech": "Noun",
          "source_context": "Unit 5: A Homage to Our Brave Soldiers"
        }
      ],
      "spelling": [
        {
          "word": "Posthumous",
          "phonetic_hint": "post-hyoo-mus",
          "difficulty": "High",
          "source_context": "Unit 5"
        },
        {
          "word": "Obelisk",
          "phonetic_hint": "ob-uh-lisk",
          "difficulty": "Medium",
          "source_context": "Unit 5"
        },
        {
          "word": "Catamaran",
          "phonetic_hint": "kat-uh-muh-ran",
          "difficulty": "Medium",
          "source_context": "Unit 1"
        },
