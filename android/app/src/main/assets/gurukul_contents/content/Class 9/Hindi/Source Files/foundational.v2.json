            {
              "word": "स्वाभिमानी",
              "prefix_or_suffix": "स्व (उपसर्ग) + ई (प्रत्यय)",
              "root_word": "अभिमान",
              "chapter_context": "रीढ़ की हड्डी"
            }
          ]
        },
        {
          "topic": "समास परिचय (Compound Words)",
          "explanation": "दो या दो से अधिक शब्दों के मेल से नए सार्थक शब्द बनाने की प्रक्रिया को समास कहते हैं।",
          "examples": [
            {
