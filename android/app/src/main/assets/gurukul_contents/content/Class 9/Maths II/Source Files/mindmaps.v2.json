  "source_data": {
    "subject": "Ganita Manjari - Class 9 Mathematics (Part II)",
    "grade_level": "Class 9",
    "curriculum_standard": "NCERT / CBSE",
    "resource_type": "Comprehensive Mind Map Hierarchy",
    "chapters": [
      {
        "chapter_number": 9,
        "chapter_title": "Propositions and their Converses",
        "mind_map": {
          "root_topic": "Propositions and their Converses",
          "branches": [
            {
              "theme": "Logical Foundations of Propositions & Implication",
              "sub_branches": [
                {
                  "concept": "Conditional Propositions (If P then Q)",
                  "details": [
                    "A proposition is a declarative statement that is definitively either true or false.",
                    "Expressed as 'If P then Q', 'P implies Q', 'Q when P', or 'P is sufficient for Q'.",
                    "Premise P is the hypothesis; consequence Q is the conclusion.",
                    "The truth value of an implication depends on the formal logical relationship between P and Q."
                  ],
                  "evidence_or_examples": [
                    "If a number is a multiple of 6, then it is a multiple of 3 (True).",
                    "If a number is a perfect square, then it has an odd number of factors (True)."
                  ],
                  "key_terms": [
                    "Proposition",
                    "Premise / Hypothesis",
                    "Conclusion / Consequence",
                    "Implication (P -> Q)"
                  ]
                },
                {
                  "concept": "Formulating and Evaluating Converse Statements",
                  "details": [
                    "The converse of 'If P then Q' is formed by swapping hypothesis and conclusion to obtain 'If Q then P'.",
                    "A proposition and its converse are logically independent statements.",
                    "The truth of an implication does not guarantee the truth of its converse."
                  ],
                  "evidence_or_examples": [
                    "Proposition: 'If a quadrilateral is a square, then all its angles are equal' (True). Converse: 'If all angles of a quadrilateral are equal, then it is a square' (False; counterexample: rectangle with unequal adjacent sides)."
                  ],
                  "key_terms": [
                    "Converse Statement (Q -> P)",
                    "Logical Independence",
                    "Bi-implication / Equivalence (P <-> Q)"
                  ]
                },
                {
                  "concept": "Contrapositive Equivalence",
                  "details": [
                    "The contrapositive of 'If P then Q' is 'If not Q then not P'.",
                    "A proposition and its contrapositive are logically equivalent (they always share identical truth values).",
                    "Proving the contrapositive is a valid method of proving the original proposition."
                  ],
                  "evidence_or_examples": [
                    "To prove 'If n^2 is even, then n is even', prove contrapositive 'If n is odd, then n^2 is odd': (2k+1)^2 = 4k^2 + 4k + 1 = 2(2k^2 + 2k) + 1 (odd)."
                  ],
                  "key_terms": [
                    "Contrapositive (~Q -> ~P)",
                    "Logical Equivalence",
                    "Indirect Proof"
                  ]
                }
              ]
            },
            {
              "theme": "Disproof via Counterexamples & Geometric Equivalences",
              "sub_branches": [
                {
                  "concept": "Role of Counterexamples in Proofs",
                  "details": [
                    "A universal statement ('For all x, P(x)') claims something holds for every element in a set.",
                    "A single valid counterexample refutes a universal mathematical claim.",
                    "Counterexamples provide disproof, but multiple examples cannot establish general proof."
                  ],
                  "evidence_or_examples": [
                    "Euler disproving Fermat's prime conjecture F_n = 2^(2^n) + 1 at n=5: F_5 = 4,294,967,297 = 641 x 6,700,417 (composite).",
                    "Triangles with equal perimeters (3,4,5 and 4,4,4) are not congruent."
                  ],
                  "key_terms": [
                    "Counterexample",
                    "Refutation",
                    "Universal Quantifier (For All)",
                    "Existential Quantifier (Exists)"
                  ]
                },
                {
                  "concept": "Baudhāyana-Pythagoras Equivalence & Angle Bisectors",
                  "details": [
                    "When both proposition and converse are true, the conditions are logically equivalent (if and only if).",
                    "Pythagoras Theorem and its converse form a bi-conditional equivalence: right-angled at C <==> a^2 + b^2 = c^2.",
                    "Steiner-Lehmus Theorem: Equal angle bisectors implies isosceles triangle (converse of isosceles angle bisector property)."
                  ],
                  "evidence_or_examples": [
                    "Masons using 3-4-5 knotted rope loops to lay exact 90-degree corners relying on the converse of Pythagoras theorem."
                  ],
                  "key_terms": [
                    "Equivalence (<==>)",
                    "Necessary and Sufficient Conditions",
                    "Baudhāyana-Pythagoras Converse",
                    "Steiner-Lehmus Theorem"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "chapter_number": 10,
        "chapter_title": "How Quantities Combine: Understanding Data",
        "mind_map": {
          "root_topic": "How Quantities Combine: Understanding Data",
          "branches": [
            {
              "theme": "Weighted Mean and Data Aggregation",
              "sub_branches": [
                {
                  "concept": "Fallacy of Unweighted Averages in Unequal Groups",
                  "details": [
                    "Taking a simple unweighted average of group means ignores group size differences.",
                    "Larger groups exert a greater pull on the true overall population mean.",
                    "Weighted arithmetic mean accounts for subgroup counts or weights w_i."
                  ],
                  "evidence_or_examples": [
                    "Combining Section A (30 students, avg 80%) and Section B (10 students, avg 60%) yields true weighted mean 75%, not 70%."
                  ],
                  "key_terms": [
                    "Simple Average",
                    "Weighted Mean",
                    "Weights (w_i)",
                    "Subgroup Aggregation"
                  ]
                },
                {
                  "concept": "Weighted Mean Formula and Physical/Financial Applications",
                  "details": [
                    "Formula: x_bar = sum(w_i * x_i) / sum(w_i).",
                    "Used in weighted test grading, gold alloy purity, solution concentration, and mixture blending.",
                    "Preserves total quantity and mass conservation across combined subsets."
                  ],
                  "evidence_or_examples": [
                    "Academic grade calculation with assignments (30%), midterm (20%), and final exam (50%).",
                    "Mixing brass alloy Batch A (200 kg at 70%), Batch B (120 kg at 50%), and Batch C (240 kg at 45%) to get 55% concentration."
                  ],
                  "key_terms": [
                    "Formula: x_bar = sum(w_i * x_i) / sum(w_i)",
                    "Percentage Concentration",
                    "Mass Conservation"
                  ]
                },
                {
                  "concept": "Rate Combinations & Weighted Harmonic Mean",
                  "details": [
                    "Combining speeds v_i over equal distances d_i requires weighted harmonic mean, not arithmetic mean.",
                    "Formula for average speed: v_avg = sum(d_i) / sum(d_i / v_i) = Total Distance / Total Time.",
                    "Simpson's Paradox occurs when aggregated group weights cause overall statistical trends to reverse."
                  ],
                  "evidence_or_examples": [
                    "Traveling 100 km at 40 km/h and returning 100 km at 60 km/h yields average speed 48 km/h, not 50 km/h."
                  ],
                  "key_terms": [
                    "Weighted Harmonic Mean",
                    "Rate/Speed Combinations",
                    "Simpson's Paradox"
                  ]
                }
              ]
            },
            {
              "theme": "Multi-Category Data Visualizations",
              "sub_branches": [
                {
                  "concept": "Cluster-Column, Stacked Bar & 100% Stacked Bar Charts",
                  "details": [
                    "Cluster-column charts place category bars side-by-side per group.",
                    "Stacked bar charts stack category components vertically to preserve absolute group totals.",
                    "100% stacked bar charts scale all group bars to 100% height to isolate relative percentage distributions."
                  ],
                  "evidence_or_examples": [
                    "Comparing household spending (housing, food, education, healthcare) across families with different total incomes."
                  ],
                  "key_terms": [
                    "Cluster-Column Chart",
                    "Stacked Bar Chart",
                    "100% Stacked Bar Chart",
                    "Relative Proportions vs Absolute Totals"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "chapter_number": 11,
        "chapter_title": "The World of Algorithms",
        "mind_map": {
          "root_topic": "The World of Algorithms",
          "branches": [
            {
              "theme": "Algorithmic Logic and Data Structures",
              "sub_branches": [
                {
                  "concept": "Definition and Historical Origins of Algorithms",
                  "details": [
                    "An algorithm is a finite, ordered, step-by-step, unambiguous problem-solving procedure.",
                    "Named after 9th-century Persian mathematician Muhammad ibn Musa al-Khwarizmi.",
                    "Relies on sequential lists and state data structures to track intermediate variables."
                  ],
                  "evidence_or_examples": [
                    "Place-value long division algorithm for multi-digit decimal numerals."
                  ],
                  "key_terms": [
                    "Algorithm",
                    "Al-Khwarizmi",
                    "Ordered List Data Structure",
                    "Modulo Operator (m mod n)"
                  ]
                }
              ]
            },
            {
              "theme": "Greatest Common Divisor (GCD) & Computational Complexity",
              "sub_branches": [
                {
                  "concept": "Euclidean Subtraction Method",
                  "details": [
                    "Based on property gcd(m, n) = gcd(n, m - n) for m >= n.",
                    "Repeats subtraction loops until both numbers become equal.",
                    "Has linear time complexity O(N); inefficient for large numbers."
                  ],
                  "evidence_or_examples": [
                    "Computing gcd(99, 2) requires 49 iterative subtraction steps."
                  ],
                  "key_terms": [
                    "Euclidean Subtraction",
                    "Common Divisor Difference Property",
                    "Linear Complexity O(N)"
                  ]
                },
                {
                  "concept": "Āryabhaṭa's Remainder Division Algorithm",
                  "details": [
                    "Based on remainder reduction property gcd(m, n) = gcd(n, m mod n).",
                    "Replaces multiple subtraction iterations with a single division remainder step.",
                    "Has logarithmic time complexity O(log N); scales efficiently with digit length.",
                    "Recorded in Aryabhatiya (499 CE)."
                  ],
                  "evidence_or_examples": [
                    "Computing gcd(99, 2) completes in 2 remainder steps: 99 mod 2 = 1, 2 mod 1 = 0.",
                    "gcd(540, 192) -> 540 mod 192 = 156 -> 192 mod 156 = 36 -> 156 mod 36 = 12 -> 36 mod 12 = 0 (GCD = 12)."
                  ],
                  "key_terms": [
                    "Āryabhaṭa Remainder Algorithm",
                    "Remainder Reduction (m mod n)",
                    "Logarithmic Complexity O(log N)",
                    "Safe LCM: (m // gcd) * n"
                  ]
                },
                {
                  "concept": "Lamé's Theorem & Bezout's Identity",
                  "details": [
                    "Lamé's Theorem proves consecutive Fibonacci numbers (F_{k+1}, F_k) represent the worst-case inputs for Euclidean/Āryabhaṭa GCD algorithms.",
                    "Bezout's Identity states gcd(a, b) can be expressed as linear combination x*a + y*b."
                  ],
                  "evidence_or_examples": [
                    "gcd(89, 55) requires maximum division steps relative to digit count.",
                    "Bezout identity for a=240, b=46: gcd=2 => 2 = (-9)*240 + (47)*46."
                  ],
                  "key_terms": [
                    "Lamé's Theorem",
                    "Fibonacci Worst Case",
                    "Bezout's Identity (xa + yb = gcd)"
                  ]
                }
              ]
            }
          ]
        }
