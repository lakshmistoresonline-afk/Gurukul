  "source_data": {
    "subject": "LANGUAGE",
    "chapter": {
      "book_title": "Kaveri - Class 9 English Textbook (NCERT)",
      "total_units_covered": 8,
      "description": "Comprehensive Foundational Language Content across all 8 Units of Class 9 English Kaveri textbook."
    },
    "content": {
      "grammar": [
        {
          "item_id": "GRAM-01",
          "topic": "Past Perfect Tense vs. Simple Past Tense",
          "rule_or_concept": "Past Perfect (had + V3) denotes an action completed prior to another past action (Simple Past V2).",
          "formula_or_pattern": "Subject + had + V3 + before/by the time + Subject + V2",
          "example_from_text": "Krishtakka had decided to learn the Kannada alphabet before her granddaughter returned from the wedding.",
          "chapter_reference": "Unit 1: How I Taught My Grandmother to Read"
        },
        {
          "item_id": "GRAM-02",
          "topic": "Binomial Expressions",
          "rule_or_concept": "Fixed two-word phrases joined by a conjunction (usually 'and') in an unalterable word sequence.",
          "formula_or_pattern": "Word A + and + Word B",
          "example_from_text": "'Part and parcel', 'trial and error', 'pick and choose', 'thick and thin'.",
          "chapter_reference": "Unit 1: How I Taught My Grandmother to Read"
        },
        {
          "item_id": "GRAM-03",
          "topic": "Royal Order of Adjectives",
          "rule_or_concept": "When multiple adjectives modify a noun, they must follow a fixed hierarchical sequence.",
          "formula_or_pattern": "Opinion -> Size -> Age -> Shape -> Color -> Origin -> Material -> Purpose + Noun",
          "example_from_text": "a beautiful (opinion) antique (age) circular (shape) green (color) palm-leaf (material) pankha.",
          "chapter_reference": "Unit 3: Winds of Change (World of Pankhas)"
        },
        {
          "item_id": "GRAM-04",
          "topic": "Reported Speech for Commands and Advice",
          "rule_or_concept": "Imperative sentences in direct speech convert to infinitive clauses (to / not to + verb) using reporting verbs like instructed, advised, ordered.",
          "formula_or_pattern": "Subject + instructed/advised + Object + (not) to + Base Verb",
          "example_from_text": "Mother instructed Ravi not to let his grandfather wander off alone in the city.",
          "chapter_reference": "Unit 4: Vitamin-M"
        },
        {
          "item_id": "GRAM-05",
          "topic": "Modal Verbs of Ability and Possibility",
          "rule_or_concept": "'Can' and 'be able to' express physical capability or mental capacity; 'could' expresses past ability.",
          "formula_or_pattern": "Subject + can / could / is able to + Base Verb",
          "example_from_text": "Dr. Deepa Malik proved that determined individuals can overcome severe physical paralysis.",
          "chapter_reference": "Unit 5: The World of Limitless Possibilities"
        },
        {
          "item_id": "GRAM-06",
          "topic": "Concessive Clauses (Conjunctions of Contrast)",
          "rule_or_concept": "Conjunctions like 'although', 'even though', and 'despite' connect two contrasting statements.",
          "formula_or_pattern": "Although + Clause 1, Clause 2",
          "example_from_text": "Although Nabin was a classical purist, he warmly embraced Shruti's Indo-Western fusion performance.",
          "chapter_reference": "Unit 6: Twin Melodies"
        },
        {
