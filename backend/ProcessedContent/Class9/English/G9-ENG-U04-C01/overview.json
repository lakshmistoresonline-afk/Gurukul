    "chapters": [
      {
        "chapter_number": 1,
        "chapter_title": "How I Taught My Grandmother to Read & Bharat Our Land",
        "summary": "This unit pairs Sudha Murty's biographical memoir 'How I Taught My Grandmother to Read' with Subramania Bharati's nationalist poem 'Bharat Our Land'. The prose recounts the determination of Krishtakka, a 62-year-old illiterate village woman, who learns the Kannada alphabet from her 12-year-old granddaughter after experiencing intense helplessness when she cannot read her favorite serialized novel 'Kashi Yatre'. The poem celebrates India's majestic physical geography, spiritual heritage, intellectual traditions, and egalitarian societal ideals.",
        "image_asset": {
          "title": "Krishtakka's Literacy Timeline Diagram",
          "url": "/assets/images/ch1_literacy_timeline.png",
          "type": "16:9 PNG Diagram",
          "hotspots": [
            {
              "id": "hs_ch1_1",
              "title": "Phase 1: Dependence",
              "x_percent": 2.0,
              "y_percent": 35.0,
              "w_percent": 16.0,
              "h_percent": 25.0,
              "description": "Krishtakka relied on her 12-year-old granddaughter to read aloud weekly instalments of Kashi Yatre."
            },
            {
              "id": "hs_ch1_2",
              "title": "Phase 3: The Vow",
              "x_percent": 42.0,
              "y_percent": 35.0,
              "w_percent": 16.0,
              "h_percent": 25.0,
              "description": "Vowed at age 62 to learn the Kannada alphabet by Saraswati Pooja during Dussehra."
            },
            {
              "id": "hs_ch1_3",
              "title": "Phase 5: Self-Reliance",
              "x_percent": 82.0,
              "y_percent": 35.0,
              "w_percent": 16.0,
              "h_percent": 25.0,
              "description": "Read Kashi Yatre fluently and touched her granddaughter's feet as a Guru."
            }
          ]
        },
        "key_takeaways": [
          "Age is no bar for learning when supported by determination and passion.",
          "Literacy bestows personal independence, self-respect, and dignity.",
          "Respect for a teacher (Guru) transcends age boundaries."
        ]
      },
      {
        "chapter_number": 2,
        "chapter_title": "The Pot Maker & Gifts of Grace: Honouring Our Vocations",
        "summary": "Unit 2 focuses on indigenous craftsmanship through 'The Pot Maker', a story about a young Naga girl named Sentila who longs to become a potter despite her mother's initial disapproval. The unit celebrates manual artistry, vocational pride, and the intergenerational preservation of community heritage.",
        "image_asset": {
          "title": "Stages of Clay Pottery Creation",
          "url": "/assets/images/ch2_pottery_process.png",
          "type": "16:9 PNG Process Flow",
          "hotspots": [
            {
              "id": "hs_ch2_1",
              "title": "Wedging & Kneading",
              "x_percent": 23.5,
              "y_percent": 32.0,
              "w_percent": 15.0,
              "h_percent": 32.0,
              "description": "Kneading clay removes trapped air pockets, preventing cracking during kiln firing."
            },
            {
              "id": "hs_ch2_2",
              "title": "Hand Molding",
              "x_percent": 42.5,
              "y_percent": 32.0,
              "w_percent": 15.0,
              "h_percent": 32.0,
              "description": "Sentila practiced shaping pots in secret using wooden paddles and clay scraps."
            },
            {
              "id": "hs_ch2_3",
              "title": "Open Kiln Firing",
              "x_percent": 80.5,
              "y_percent": 32.0,
              "w_percent": 15.0,
              "h_percent": 32.0,
              "description": "Vessels are hardened overnight in open straw and wood hearths."
            }
