    "content": {
      "mathematical_vocabulary": [
        {
          "term": "Proposition",
          "context": "Chapter 9",
          "definition": "A declarative statement that is unambiguously either true or false."
        },
        {
          "term": "Converse",
          "context": "Chapter 9",
          "definition": "A conditional statement formed by interchanging the hypothesis and conclusion of an implication."
        },
        {
          "term": "Contrapositive",
          "context": "Chapter 9",
          "definition": "A conditional statement formed by negating and swapping the hypothesis and conclusion (~Q -> ~P)."
        },
        {
          "term": "Counterexample",
          "context": "Chapter 9",
          "definition": "A specific instance that refutes a universal mathematical statement."
        },
        {
          "term": "Weighted Mean",
          "context": "Chapter 10",
          "definition": "An average computed by weighting individual group values by their respective sample sizes or relative importance."
        },
        {
          "term": "100% Stacked Bar Chart",
          "context": "Chapter 10",
          "definition": "A multi-category bar chart where all bars are scaled to 100% to compare relative percentage distributions."
        },
        {
          "term": "Algorithm",
          "context": "Chapter 11",
          "definition": "A finite, ordered, unambiguous step-by-step procedure for solving a problem."
        },
        {
          "term": "Modulo Operator",
          "context": "Chapter 11",
          "definition": "An arithmetic operation (m mod n) that yields the integer remainder when m is divided by n."
        },
        {
          "term": "Greatest Common Divisor (GCD)",
          "context": "Chapter 11",
          "definition": "The largest positive integer that divides two or more given integers without a remainder."
        },
        {
          "term": "Midpoint Theorem",
          "context": "Chapter 12",
          "definition": "The segment joining midpoints of two triangle sides is parallel to the third side and half its length."
        },
        {
          "term": "Centroid",
          "context": "Chapter 12",
          "definition": "The intersection point of three medians of a triangle, dividing each median in a 2:1 ratio."
        },
        {
          "term": "Varignon Parallelogram",
          "context": "Chapter 12",
          "definition": "The parallelogram formed by connecting the adjacent side midpoints of any quadrilateral."
        },
        {
          "term": "Linear Equation in Two Variables",
          "context": "Chapter 13",
          "definition": "An algebraic equation of form ax + by + c = 0 representing a straight line on the Cartesian plane."
        },
        {
          "term": "Slope (m)",
          "context": "Chapter 13",
          "definition": "The measure of line steepness defined as vertical change divided by horizontal change (rise over run)."
        },
        {
          "term": "Slant Height (l)",
          "context": "Chapter 14",
          "definition": "The distance from the apex of a right circular cone to any point on its circular base boundary."
        }
      ],
      "definitions": [
        {
          "name": "Proposition",
          "statement": "A declarative sentence that holds a definitive truth value of either True or False, but not both."
        },
        {
          "name": "Converse Statement",
          "statement": "For conditional proposition 'If P then Q', the converse is 'If Q then P'."
        },
        {
          "name": "Contrapositive Statement",
          "statement": "For conditional proposition 'If P then Q', the contrapositive is 'If not Q then not P'."
        },
        {
          "name": "Counterexample",
          "statement": "An explicit mathematical case that satisfies premise P but violates conclusion Q, proving 'If P then Q' false."
        },
        {
          "name": "Weighted Arithmetic Mean",
          "statement": "x_bar = sum(w_i * x_i) / sum(w_i), where w_i represent sample weights and x_i represent values."
        },
        {
          "name": "Algorithm",
          "statement": "A deterministic sequence of finite, unambiguous computational instructions."
        },
        {
          "name": "Modulo Operator (m mod n)",
          "statement": "The unique integer remainder r such that m = q * n + r with 0 <= r < n."
        },
        {
          "name": "Parallelogram",
          "statement": "A planar four-sided polygon (quadrilateral) with both pairs of opposite sides parallel."
        },
        {
          "name": "Centroid G",
          "statement": "The concurrent point of intersection of a triangle's three medians, dividing medians in ratio 2:1."
        },
        {
          "name": "Slope m",
          "statement": "m = (y2 - y1) / (x2 - x1), measuring the directional steepness of a straight line."
        },
        {
          "name": "Curved Surface Area (CSA)",
          "statement": "The outer surface area of a 3D solid excluding its flat top and bottom bases."
        },
        {
          "name": "Total Surface Area (TSA)",
          "statement": "The complete surface area of a 3D solid including all curved and flat boundary faces."
        }
      ],
      "concepts": [
        {
          "title": "Logical Independence of Converses",
          "description": "A proposition P -> Q and its converse Q -> P are logically distinct. The truth of one does not imply the truth of the other."
        },
        {
          "title": "Logical Equivalence of Contrapositives",
          "description": "A conditional statement P -> Q and its contrapositive ~Q -> ~P always share identical truth values in all interpretations."
        },
        {
          "title": "Disproof by Single Counterexample",
          "description": "While confirming examples cannot prove a universal assertion, a single valid counterexample conclusively disproves it."
        },
        {
          "title": "Fallacy of Unweighted Group Averages",
          "description": "Averaging group percentages directly without multiplying by sample counts produces errors when group sizes differ."
        },
        {
          "title": "Algorithmic Efficiency Jump",
          "description": "Replacing Euclidean subtraction loops with Āryabhaṭa remainder division improves GCD complexity from linear O(N) to logarithmic O(log N)."
        },
        {
