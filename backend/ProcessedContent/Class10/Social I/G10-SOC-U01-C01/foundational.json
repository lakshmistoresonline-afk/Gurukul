        {
          "concept": "Community-Led Ecological Governance",
          "explanation": "Active participation of local indigenous populations in natural resource decision-making (e.g. Chipko Movement, JFM, Sariska legal resistance).",
          "source_context": "NCERT Class 10 Geography Chapter 2"
        },
        {
          "concept": "Sacred Groves Veneration",
          "explanation": "Traditional cultural belief systems preserving virgin forest patches as sacred realms of deities, prohibiting commercial exploitation.",
