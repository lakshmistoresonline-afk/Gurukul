        {
          "concept": "Favorable vs Unfavorable Balance of Trade",
          "explanation": "Favorable trade balance occurs when export value exceeds import value. Unfavorable occurs when import value exceeds export value.",
          "source_context": "NCERT Class 10 Geography Chapter 7"
        },
