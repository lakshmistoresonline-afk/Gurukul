      "economic_concepts": [
        {
          "concept": "Primary vs Secondary vs Tertiary Sectors",
          "explanation": "Primary sector (agriculture, mining) extracts natural resources; Secondary sector (manufacturing) transforms raw materials into finished goods; Tertiary sector (transport, trade, banking) provides support services.",
          "source_context": "NCERT Class 10 Geography Chapters 4, 6 & 7"
