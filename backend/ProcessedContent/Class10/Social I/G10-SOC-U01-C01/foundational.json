  "source_data": {
    "subject": "SOCIAL_SCIENCE",
    "chapter": {
      "title": "Social Science: Contemporary India - II (NCERT Class 10 Geography)",
      "chapters_covered": [
        "Chapter 1: Resources and Development",
        "Chapter 2: Forest and Wildlife Resources",
        "Chapter 3: Water Resources",
        "Chapter 4: Agriculture",
        "Chapter 5: Minerals and Energy Resources",
        "Chapter 6: Manufacturing Industries",
        "Chapter 7: Lifelines of National Economy"
      ]
    },
    "content": {
      "terminology": [
        {
          "term": "Resource",
          "definition": "Everything available in our environment which can be used to satisfy our needs, provided it is technologically accessible, economically feasible and culturally acceptable.",
          "source_context": "NCERT Class 10 Geography Chapter 1: Resources and Development"
        },
        {
          "term": "Regur Soil",
          "definition": "Local name for Black Soil, derived from the Telugu word 'Reguda'. Ideal for cotton cultivation.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "term": "Khadar",
          "definition": "New alluvial soil containing fine particles, deposited annually in floodplains with high fertility.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "term": "Bangar",
          "definition": "Old alluvial soil containing higher concentration of Kankar (calcareous) nodules, less fertile than Khadar.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "term": "Bad Land",
          "definition": "Land dissected by running water forming deep channels or gullies, rendering it unfit for cultivation.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "term": "Ravines",
          "definition": "Deep, steep-sided gullies and severely eroded bad lands characteristic of the Chambal river basin.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "term": "Tankas",
          "definition": "Underground concrete or masonry storage tanks built inside houses in arid Rajasthan to store harvested rainwater.",
          "source_context": "NCERT Class 10 Geography Chapter 3: Water Resources"
        },
        {
          "term": "Palar Pani",
          "definition": "Local Rajasthani term for pure rainwater collected directly via rooftop harvesting systems.",
          "source_context": "NCERT Class 10 Geography Chapter 3"
        },
        {
          "term": "Jhumming",
          "definition": "Local name for slash-and-burn shifting cultivation in North-Eastern states of India.",
          "source_context": "NCERT Class 10 Geography Chapter 4: Agriculture"
        },
        {
          "term": "Chakbandi",
          "definition": "Land consolidation scheme reorganizing fragmented farmland strips into larger operational holdings.",
          "source_context": "NCERT Class 10 Geography Chapter 4"
        },
        {
          "term": "Placer Deposits",
          "definition": "Mineral deposits found in sands of valley floors and stream beds, containing non-corrosive metals like Gold and Platinum.",
          "source_context": "NCERT Class 10 Geography Chapter 5: Minerals and Energy Resources"
        },
        {
          "term": "Agglomeration Economies",
          "definition": "Cost advantages gained when industrial units cluster near cities to share banking, transport, and power networks.",
          "source_context": "NCERT Class 10 Geography Chapter 6: Manufacturing Industries"
        },
        {
          "term": "Balance of Trade",
          "definition": "The monetary difference between the total value of a nation's exports and imports.",
          "source_context": "NCERT Class 10 Geography Chapter 7: Lifelines of National Economy"
        }
      ],
      "definitions": [
        {
          "concept": "Sustainable Development",
          "definition": "Development that satisfies present needs without compromising the ability of future generations to meet their needs or damaging the environment.",
          "source_context": "Rio Earth Summit 1992 / Brundtland Commission Report"
        },
        {
          "concept": "Net Sown Area",
          "definition": "Total physical area sown with crops and harvested within an agricultural year.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "concept": "Gross Cropped Area",
          "definition": "Total area sown once or more than once in an agricultural year (Net Sown Area + area sown multiple times).",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "concept": "Current Fallow",
          "definition": "Cropland left uncultivated for one or less than one agricultural year to naturally restore soil nutrients.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "concept": "Culturable Waste Land",
          "definition": "Farmland left uncultivated for more than 5 consecutive agricultural years.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "concept": "Joint Forest Management (JFM)",
          "definition": "Institutional program involving local village communities to manage and restore degraded state forests in exchange for non-timber produce.",
          "source_context": "NCERT Class 10 Geography Chapter 2"
        },
        {
          "concept": "Minimum Support Price (MSP)",
          "definition": "Floor price announced by the government prior to sowing seasons to guarantee farmers against distress selling.",
          "source_context": "NCERT Class 10 Geography Chapter 4"
        }
      ],
      "concepts": [
        {
          "title": "Interdependent Triangle of Resource Creation",
          "explanation": "Human beings interact with nature through technology and build institutions to transform materials into resources.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "title": "Stock vs Reserves",
          "explanation": "Stock refers to environmental materials with potential to meet human needs but lacking technological access. Reserves are a subset of stock that can be utilized with existing technology but are stored for future use.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "title": "Quantitative vs Qualitative Water Scarcity",
          "explanation": "Quantitative scarcity is a physical deficit in water volume relative to population. Qualitative scarcity occurs when abundant water is contaminated by industrial, agricultural, and urban pollution.",
          "source_context": "NCERT Class 10 Geography Chapter 3"
        },
        {
          "title": "Three-Stage Effluent Treatment",
          "explanation": "Primary (mechanical screening & sedimentation), Secondary (biological treatment & aeration), Tertiary (chemical recycling to achieve zero liquid discharge).",
          "source_context": "NCERT Class 10 Geography Chapter 6"
        }
      ],
      "facts": [
        {
          "fact": "India's total geographical land area is 3.28 million square kilometers, with land utilization data available for 93%.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "fact": "India possesses approximately 8% of the total global species richness, estimating nearly 1.6 million species.",
          "source_context": "NCERT Class 10 Geography Chapter 2"
        },
        {
          "fact": "Reserved and Protected forests together account for two-thirds of India's total forest area.",
          "source_context": "NCERT Class 10 Geography Chapter 2"
        },
        {
          "fact": "Fresh water constitutes only 2.5% of total global water resources, with the majority trapped in ice sheets and glaciers.",
          "source_context": "NCERT Class 10 Geography Chapter 3"
        },
        {
          "fact": "Magnetite is the finest quality iron ore containing up to 70% iron with excellent magnetic properties.",
          "source_context": "NCERT Class 10 Geography Chapter 5"
        },
        {
          "fact": "India's road network spans approximately 5.6 million kilometers, forming one of the largest road systems in the world.",
          "source_context": "NCERT Class 10 Geography Chapter 7"
        }
      ],
      "people": [
        {
          "name": "Mahatma Gandhi",
          "role": "Philosopher & Leader",
          "contribution": "Voiced deep concern over resource conservation: 'There is enough for everybody's need and not for any body's greed.'",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "name": "Vinoba Bhave",
          "role": "Social Reformer & Gandhian Disciple",
          "contribution": "Initiated the Bhoodan-Gramdan movement ('Bloodless Revolution') at Pochampally for voluntary land redistribution.",
          "source_context": "NCERT Class 10 Geography Chapter 4"
        },
        {
          "name": "Shri Ram Chandra Reddy",
          "role": "Landowner",
          "contribution": "Offered 80 acres of land to 80 landless villagers in Pochampally, sparking the Bhoodan movement.",
          "source_context": "NCERT Class 10 Geography Chapter 4"
        },
        {
          "name": "Jawaharlal Nehru",
          "role": "First Prime Minister of India",
          "contribution": "Proclaimed multi-purpose dams as the 'Temples of Modern India' to integrate agricultural development with industrialization.",
          "source_context": "NCERT Class 10 Geography Chapter 3"
        }
      ],
      "places": [
        {
          "place": "Rio de Janeiro, Brazil",
          "significance": "Host location of the first International Earth Summit in June 1992, adopting Agenda 21.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "place": "Chambal River Basin",
          "significance": "Famous for severe gully erosion forming uncultivable bad lands known as ravines.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "place": "Sariska Tiger Reserve, Rajasthan",
          "significance": "Site where local villagers cited the Wildlife Protection Act to successfully stop illegal limestone mining.",
          "source_context": "NCERT Class 10 Geography Chapter 2"
        },
        {
          "place": "Gendathur, Mysuru, Karnataka",
          "significance": "Remote village where 200 households installed rooftop rainwater harvesting to collect 100,000 liters annually per house.",
          "source_context": "NCERT Class 10 Geography Chapter 3"
        },
        {
          "place": "Khetri, Rajasthan",
          "significance": "Renowned for major underground copper mining operations.",
          "source_context": "NCERT Class 10 Geography Chapter 5"
        },
        {
          "place": "Kandla (Deendayal Port), Gujarat",
          "significance": "First major sea port developed post-1947 in Kutch to replace Karachi port capacity and relieve Mumbai port congestion.",
          "source_context": "NCERT Class 10 Geography Chapter 7"
        }
      ],
      "dates_events": [
        {
          "year_or_date": "1992 (June)",
          "event": "Rio de Janeiro Earth Summit convened with over 100 heads of state to adopt Agenda 21.",
          "source_context": "NCERT Class 10 Geography Chapter 1"
        },
        {
          "year_or_date": "1972",
          "event": "Enactment of the Indian Wildlife (Protection) Act establishing protected species lists and hunting bans.",
          "source_context": "NCERT Class 10 Geography Chapter 2"
        },
        {
          "year_or_date": "1973",
          "event": "Launch of Project Tiger, one of the world's most publicized wildlife conservation initiatives.",
          "source_context": "NCERT Class 10 Geography Chapter 2"
        },
        {
          "year_or_date": "1988",
          "event": "First formal state resolution passed for Joint Forest Management (JFM) by the government of Odisha.",
          "source_context": "NCERT Class 10 Geography Chapter 2"
        },
        {
          "year_or_date": "1854",
          "event": "Establishment of the first successful modern cotton textile mill in Mumbai.",
          "source_context": "NCERT Class 10 Geography Chapter 6"
        }
      ],
