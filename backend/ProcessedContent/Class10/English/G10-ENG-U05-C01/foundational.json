    "content": {
      "grammar": [
        {
          "topic": "Relative Clauses (Defining & Non-Defining)",
          "explanation": "Relative clauses give additional information about a noun using relative pronouns like who, which, that, whose, where.",
          "examples": [
            "Lencho was a farmer who had unwavering faith in God. (Defining)",
            "The postmaster, who was a fat and amiable fellow, decided to answer the letter. (Non-defining)"
          ],
          "source_context": "NCERT Class 10 English - Chapter 1 (jeff101.pdf)"
        },
        {
          "topic": "Formation of Nouns from Verbs (Suffixation)",
          "explanation": "Nouns can be formed from verbs by adding suffixes such as -tion, -ment, -ance, -ence, -ion.",
          "examples": [
            "Emancipate -> Emancipation",
            "Obligate -> Obligation",
            "Inaugurate -> Inauguration",
            "Rebel -> Rebellion"
          ],
          "source_context": "NCERT Class 10 English - Chapter 2 (jeff102.pdf)"
        },
        {
          "topic": "Past Habitual Markers ('Used to' vs 'Would')",
          "explanation": "'Used to' expresses past states or repeated actions, whereas 'would' expresses repeated past actions in narrative context.",
          "examples": [
            "The baker used to be our friend, companion, and guide. (Past state/habit)",
            "Mijbil would jump and roll in the bathtub for hours. (Repeated past action)"
          ],
          "source_context": "NCERT Class 10 English - Chapter 5 & 6 (jeff105.pdf & jeff106.pdf)"
        },
        {
          "topic": "Reported Speech (Direct to Indirect Speech)",
          "explanation": "Transforming spoken dialogue into reported clauses by shifting tenses (present to past), updating pronouns, and selecting appropriate reporting verbs.",
          "examples": [
            "Direct: Lomov said, 'I've come to ask the hand of your daughter.'",
            "Indirect: Lomov stated that he had come to ask for the hand of his daughter in marriage."
          ],
          "source_context": "NCERT Class 10 English - Chapter 9 (jeff109.pdf)"
        },
        {
          "topic": "Noun Modifiers and Descriptive Adjectives",
          "explanation": "Nouns can act as modifiers preceding other nouns to specify function, material, or origin.",
          "examples": [
            "Coffee plantations",
            "Sandstone amphitheatre",
            "Ping-pong ball"
          ],
          "source_context": "NCERT Class 10 English - Chapter 2, 5, 6 (jeff102.pdf, jeff105.pdf, jeff106.pdf)"
        }
      ],
      "vocabulary": [
        {
          "word": "Crest",
          "meaning": "The top or highest point of a hill or mountain",
          "part_of_speech": "Noun",
          "context_sentence": "Lencho's house was situated on the crest of a low hill.",
          "source_context": "Chapter 1 (jeff101.pdf)"
        },
        {
          "word": "Amphitheatre",
          "meaning": "An open-air unroofed venue with tiered seating surrounding a central arena",
          "part_of_speech": "Noun",
          "context_sentence": "The inauguration ceremony took place in the Union Buildings amphitheatre.",
          "source_context": "Chapter 2 (jeff102.pdf)"
        },
        {
          "word": "Epistemology",
          "meaning": "The philosophical study of the nature, origin, and limits of human knowledge",
          "part_of_speech": "Noun",
          "context_sentence": "The boy learns the epistemology of loss in John Berryman's poem.",
          "source_context": "Chapter 3 (jeff103.pdf)"
        },
        {
          "word": "Incorrigible",
          "meaning": "Not able to be corrected, changed, or reformed",
          "part_of_speech": "Adjective",
          "context_sentence": "Anne was assigned an essay titled 'An Incorrigible Chatterbox'.",
          "source_context": "Chapter 4 (jeff104.pdf)"
        },
        {
          "word": "Kuppia",
          "meaning": "A traditional long black coat with an embroidered waist-belt worn by the Kodavus",
          "part_of_speech": "Noun",
          "context_sentence": "The Kodavus wear kuppia which resembles the kuffia worn by Arabs.",
          "source_context": "Chapter 5 (jeff105.pdf)"
        },
        {
          "word": "Compulsion",
          "meaning": "An irresistible urge to behave in a certain way",
          "part_of_speech": "Noun",
          "context_sentence": "Mijbil had a compulsion to touch every school boundary railing.",
          "source_context": "Chapter 6 (jeff106.pdf)"
        },
        {
          "word": "Wistfully",
          "meaning": "With a feeling of vague, regretful longing or yearning",
          "part_of_speech": "Adverb",
          "context_sentence": "Valli stared wistfully at the bus passengers.",
          "source_context": "Chapter 7 (jeff107.pdf)"
        },
        {
          "word": "Lamentation",
          "meaning": "The passionate expression of grief, sorrow, or weeping",
          "part_of_speech": "Noun",
          "context_sentence": "He who draws out the arrow of lamentation shall obtain peace.",
          "source_context": "Chapter 8 (jeff108.pdf)"
        },
        {
          "word": "Pettifogger",
          "meaning": "A petty, quibbling, or dishonest lawyer",
          "part_of_speech": "Noun",
          "context_sentence": "Chubukov insults Lomov's family line as pettifoggers.",
          "source_context": "Chapter 9 (jeff109.pdf)"
        }
      ],
      "spelling": [
        {
          "term": "Poetic License Spellings",
          "standard_spelling": "leapt, dying",
          "poetic_spelling": "lept, dyin'",
          "rule_or_note": "Poets intentionally alter standard spellings to preserve rhythm, meter, and humorous rhyme.",
          "source_context": "Carolyn Wells - How to Tell Wild Animals (jeff103.pdf)"
        },
        {
          "term": "British vs American English",
          "standard_spelling": "Amphitheatre (British) vs Amphitheater (American); Colour (British) vs Color (American)",
          "poetic_spelling": "Amphitheatre, Colour",
          "rule_or_note": "NCERT texts adhere strictly to standard UK/Commonwealth English spellings.",
          "source_context": "NCERT Class 10 Textbook Standards (jeff1ps.pdf)"
        }
      ],
      "word_usage": [
        {
          "word": "Downpour vs Shower",
          "nuance": "'Downpour' indicates a heavy, intense rainstorm; 'shower' denotes a light, gentle rain.",
          "example": "The earth needed a downpour or at least a shower.",
          "source_context": "Chapter 1 (jeff101.pdf)"
        },
        {
          "word": "Emancipation vs Freedom",
          "nuance": "'Emancipation' specifically refers to legal/political liberation from systemic bondage, whereas 'freedom' is broader.",
          "example": "We pledge to liberate all our people from the continuing bondage of poverty and emancipation.",
          "source_context": "Chapter 2 (jeff102.pdf)"
        },
        {
          "word": "Slack time",
          "nuance": "Refers to off-peak hours during business operations when activity is minimal.",
          "example": "The afternoon 1 to 4 PM was the bus conductor's slack time.",
          "source_context": "Chapter 7 (jeff107.pdf)"
        }
      ],
      "sentence_structure": [
        {
          "type": "Exclamatory & Metaphorical Sentence",
          "pattern": "Subject + Verb + Complement (Metaphorical Coinage)",
          "example": "These aren't raindrops falling from the sky, they are new coins.",
          "source_context": "Chapter 1 (jeff101.pdf)"
        },
        {
          "type": "Parallel Inversion for Rhetorical Emphasis",
          "pattern": "Not only [Clause A], but also [Clause B]",
          "example": "Not only was my own freedom curtailed, but the freedom of everyone who looked like I did was also restricted.",
          "source_context": "Chapter 2 (jeff102.pdf)"
        },
        {
          "type": "Parenthetical Interruption in Verse",
          "pattern": "Main narrative stanza followed by (Parenthetical internal monologue)",
          "example": "(There is a languid, emerald sea, where the sole inhabitant is me— a mermaid, drifting blissfully.)",
          "source_context": "Chapter 4 - Amanda! (jeff104.pdf)"
        }
      ],
      "idioms_expressions": [
